{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "FaultInjection": {
    "Enabled": false
  },
  "Kafka": {
    "BootstrapServers": "",
    "Environment": "dev",
    "ClientId": "swiftbets-placement"
  },
  "Jwt": {
    "Authority": "",
    "Audience": "swiftbets",
    "RequireHttpsMetadata": true
  },
  "Identity": {
    "Issuer": "",
    "Audience": "swiftbets",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7,
    "SeedDemoUsers": false
  },
  "Placement": {
    "SagaDeadlineSeconds": 30,
    "SweepIntervalSeconds": 5
  },
  "Wallet": {
    "GrpcAddress": "",
    "DeadlineSeconds": 5
  }
}
